# ── Database ─────────────────────────────────────────────────────────────────
# Aiven free PostgreSQL service URI (console.aiven.io → your service → Overview → Service URI).
# KEEP both query params:
#   sslmode=require      → Aiven needs TLS
#   connection_limit=5   → Aiven free allows only 20 total connections and has no pooler;
#                          the app keeps its own tiny pool (max 4, set in lib/prisma.ts)
DATABASE_URL="postgresql://avnadmin:YOUR-PASSWORD@pg-your-service.a.aivencloud.com:12345/defaultdb?sslmode=require&connection_limit=5"

# ── Auth secrets (any long random strings; never share/commit) ───────────────
JWT_SECRET="paste-random-64-hex"
CRON_SECRET="paste-random-32-hex"

# ── Telegram bot (primary nightly channel) ───────────────────────────────────
# Token from @BotFather: open Telegram → search @BotFather → /newbot → it replies
# with something like 123456789:AAE_xxxxxxxxxxxxxxxxxxxxxxxxxx — paste that here.
TELEGRAM_BOT_TOKEN=""

# ── Nightly 12 AM IST summary mail (Gmail app password) ──────────────────────
# Your Gmail address + a 16-character app password.
# Google Account → Security → 2-Step Verification ON → search "App passwords" → create one.
SMTP_USER="you@gmail.com"
SMTP_PASS="16-char-app-password"